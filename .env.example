# Configuración de la aplicación
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Configuración de la base de datos
SQLALCHEMY_DATABASE_URI=sqlite:///data/multimedia.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Configuración de directorios
UPLOAD_FOLDER=uploads
IMPORT_FOLDER=imports

# Configuración de formatos de archivo permitidos
IMAGE_EXTENSIONS=jpg,jpeg,png,gif,bmp,tiff,webp,heic,svg,raw,cr2,cr3
VIDEO_EXTENSIONS=mp4,avi,mov,wmv,flv,mkv,8mm,hi8,digital8
AUDIO_EXTENSIONS=mp3,wav,ogg,aac,flac